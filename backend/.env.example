# PostgreSQL Connection String
# For local PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/factory
# For Supabase: postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# Fallback for local quick test: sqlite:///./factory.db
DATABASE_URL=sqlite:///./factory.db

# Host & Port
PORT=8000
HOST=0.0.0.0

# Simulation Configuration
READING_RETENTION_MINUTES=120
SIMULATION_TICK_SECONDS=1.0
SIMULATION_DEFAULT_SPEED=1.0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
